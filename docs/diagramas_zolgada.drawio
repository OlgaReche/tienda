ml=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="420" width="480" height="120" as="geometry"/></mxCell><mxCell id="g" value="NO PUEDE ACCEDER (zona de administración)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fillColor=none;dashed=1;strokeColor=#b85450;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1080" height="190" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Panel&lt;/b&gt; admin/index.php" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="240" height="70" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Usuarios&lt;/b&gt; admin/usuarios.php&lt;br&gt;y usuario_form.php" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="630" width="240" height="70" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Artículos&lt;/b&gt; admin/articulos.php&lt;br&gt;y articulo_form.php" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="240" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Pedidos&lt;/b&gt; admin/pedidos.php" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="860" y="630" width="260" height="70" as="geometry"/></mxCell><mxCell id="n5" value="Todas empiezan con &lt;b&gt;requerir_admin()&lt;/b&gt;: si un cliente escribe la dirección a mano, se le redirige fuera." style="text;html=1;align=left;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="1040" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4.4 · E-R"><mxGraphModel dx="1180" dy="760" grid="1" gridSize="10" guides="1" page="1" pageWidth="1180" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Tienda Zolgada&lt;/b&gt; · Diagrama Entidad-Relación (tienda_zapatillas)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="usu" value="&lt;b&gt;USUARIOS&lt;/b&gt;&lt;hr&gt;🔑 &lt;b&gt;id&lt;/b&gt; (PK)&lt;br&gt;nombre · apellidos&lt;br&gt;email (UNIQUE)&lt;br&gt;password (hash)&lt;br&gt;telefono (opcional)&lt;br&gt;direccion (opcional)&lt;br&gt;rol ENUM('admin','cliente')&lt;br&gt;fecha_alta" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="300" height="208" as="geometry"/></mxCell><mxCell id="ped" value="&lt;b&gt;PEDIDOS&lt;/b&gt;&lt;hr&gt;🔑 &lt;b&gt;id&lt;/b&gt; (PK)&lt;br&gt;🔗 &lt;b&gt;usuario_id&lt;/b&gt; (FK → usuarios)&lt;br&gt;fecha&lt;br&gt;direccion_envio&lt;br&gt;total&lt;br&gt;estado ENUM('pendiente','enviado',&lt;br&gt;'entregado','cancelado')" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="300" height="164" as="geometry"/></mxCell><mxCell id="lin" value="&lt;b&gt;LINEAS_PEDIDO&lt;/b&gt;&lt;hr&gt;🔑 &lt;b&gt;id&lt;/b&gt; (PK)&lt;br&gt;🔗 &lt;b&gt;pedido_id&lt;/b&gt; (FK → pedidos, ON DELETE CASCADE)&lt;br&gt;🔗 &lt;b&gt;articulo_id&lt;/b&gt; (FK → articulos)&lt;br&gt;cantidad&lt;br&gt;precio_unitario" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="300" height="142" as="geometry"/></mxCell><mxCell id="art" value="&lt;b&gt;ARTICULOS&lt;/b&gt;&lt;hr&gt;🔑 &lt;b&gt;id&lt;/b&gt; (PK)&lt;br&gt;nombre · marca&lt;br&gt;descripcion&lt;br&gt;talla DECIMAL(3,1)&lt;br&gt;color (opcional)&lt;br&gt;precio · stock&lt;br&gt;imagen&lt;br&gt;activo (1 a la venta / 0 oculto)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="380" width="300" height="208" as="geometry"/></mxCell><mxCell id="r1" value="1 : N&lt;br&gt;realiza" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=entityRelationEdgeStyle;html=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="usu" target="ped"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="1 : N&lt;br&gt;contiene" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERoneToMany;" edge="1" parent="1" source="ped" target="lin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="1 : N&lt;br&gt;aparece en" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=entityRelationEdgeStyle;html=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="art" target="lin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="&lt;b&gt;Relación N:M entre pedidos y artículos&lt;/b&gt;&lt;br&gt;Un pedido tiene muchos artículos y un artículo puede estar en muchos pedidos. Se resuelve con la tabla intermedia &lt;b&gt;lineas_pedido&lt;/b&gt;, que guarda además la cantidad y el precio en el momento de la compra." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="320" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>